    "error.subnet.invalidIPv4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان IPv4 غير صالح. استخدم الصيغة المنقوطة مثل 192.168.1.10."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid IPv4 address. Use dotted form like 192.168.1.10."
          }
        }
      }
    },
    "error.subnet.invalidIPv6": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان IPv6 غير صالح. مثال: 2001:db8::1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid IPv6 address. Example: 2001:db8::1."
          }
        }
      }
    },
    "error.subnet.invalidMask": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قناع شبكة غير صالح."
