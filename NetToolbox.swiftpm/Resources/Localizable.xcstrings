    "error.subnet.invalidPrefix": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بادئة غير صالحة. ‏IPv4: من 0 إلى 32، وIPv6: من 0 إلى 128."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid prefix. IPv4: 0–32, IPv6: 0–128."
          }
        }
      }
    },
    "error.subnet.nonContiguous": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون قناع الشبكة متصلاً (آحاد متبوعة بأصفار)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subnet mask must be contiguous (ones followed by zeros)."
          }
        }
      }
    },
