# إعدادات fastlane match — إدارة الشهادات عبر مستودع git مشفّر.
#
# مهم: هذا المستودع يشارك WhatsX نفس مستودع الشهادات ونفس MATCH_PASSWORD.
# match يخزّن شهادة توزيع واحدة لكل الحساب (Apple تسمح باثنتين كحد أقصى)
# وملف تزويد منفصلاً لكل معرّف حزمة. لذلك لا تعارض بين التطبيقين — بل هذا
# هو الاستخدام الصحيح: شهادة مشتركة، وملفات تزويد متعددة.

_match_git_url = ENV["MATCH_GIT_URL"].to_s.strip
git_url(_match_git_url.empty? ? "https://github.com/M-S-JABER/certificates" : _match_git_url)

storage_mode("git")
git_branch("main")
type("appstore")

app_identifier(["com.m-s-jaber.nettoolbox"])

# readonly هو الوضع الافتراضي الآمن. lane :bootstrap_signing وحده يتجاوزه.
readonly(true)
